; Engine configuration file.
config_version=5

[application]

config/name="Cascadia"
config/description="Versione digitale di Cascadia (Randy Flynn — Flatout Games / AEG) con l'espansione Landmarks."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4")
config/icon="res://assets/misc/icona.png"
boot_splash/bg_color=Color(0.92, 0.89, 0.8, 1)
boot_splash/image="res://assets/misc/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

textures/canvas_textures/default_texture_filter=1
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
